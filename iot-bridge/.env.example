# Copy these values into your shell environment. Never commit the real key.
DMD_IOT_API_URL=http://127.0.0.1:8000/api/iot/attendance/fingerprint
# The bridge polls this HTTPS operation family for Admin enrollment jobs.
DMD_IOT_ENROLLMENT_API_URL=http://127.0.0.1:8000/api/iot/fingerprint-enrollment
DMD_IOT_SERIAL_PORT=
DMD_IOT_AUTO_DETECT_SERIAL=true
DMD_IOT_DEVICE_KEY=
DMD_IOT_BRIDGE_CONTROL_KEY=
DMD_IOT_SIGNATURE_TOLERANCE_SECONDS=300
DMD_IOT_DEVICE_ID=mega-as608-01
DMD_IOT_API_TIMEOUT_SECONDS=5
DMD_IOT_API_RETRY_COUNT=1
DMD_IOT_API_RETRY_DELAY_SECONDS=0.25
DMD_IOT_ENROLLMENT_POLL_SECONDS=2
DMD_IOT_DELETE_TIMEOUT_SECONDS=15
DMD_IOT_SERIAL_RECONNECT_DELAY_SECONDS=3
