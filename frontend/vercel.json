{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://dmd-production-5759.up.railway.app/api/:path*"
    },
    {
      "source": "/sanctum/:path*",
      "destination": "https://dmd-production-5759.up.railway.app/sanctum/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://dmd-production-5759.up.railway.app/auth/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}